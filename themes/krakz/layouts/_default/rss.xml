{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = where $pctx.RegularPages "Section" "in" (site.Params.mainSections | default (slice "articles")) -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = $pages | first $limit -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{ . }} · {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <generator>Hugo · ox-hugo</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with site.Params.author }}<managingEditor>{{ . }}</managingEditor>{{ end }}
    {{- with $pages.ByLastmod.Reverse }}<lastBuildDate>{{ (index . 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- range .Params.tags }}<category>{{ . }}</category>{{ end }}
      <description>{{ .Description | default .Summary | plainify | replaceRE `\*+` "" | replaceRE `^\s+|\s+$` "" }}</description>
      {{- if site.Params.feedFullContent }}
      <content:encoded>{{ printf "<![CDATA[%s]]>" (.Content | replaceRE `[\x00-\x08\x0B\x0C\x0E-\x1F]` "" | replaceRE `]]>` "]]]]><![CDATA[>") | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
